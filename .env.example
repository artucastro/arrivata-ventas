# ─── Local ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
FLASK_SECRET_KEY=cambia-esto-por-algo-largo-y-secreto

# ─── Login ──────────────────────────────────────────────────────────
# Toda la app requiere sesión iniciada (ver /login). Dos formas de entrar:
#   - Cuenta individual (Arturo, Emmanuel, ...): usuario + contraseña propios,
#     en la tabla `users`. Se crean con scripts/manage_users.py, NO acá.
#   - Solo lectura: una única contraseña compartida, sin usuario. Sin esta
#     variable seteada, la pestaña "Solo lectura" del login no deja entrar a nadie.
VIEWER_PASSWORD=

# APP_USER / APP_PASSWORD (login HTTP Basic compartido) ya NO se usan —
# reemplazados por el login de arriba. Si los tenías seteados en un .env
# viejo, no rompen nada, simplemente se ignoran.

# ─── Base de datos ──────────────────────────────────────────────────
# Producción / acceso multi-usuario: URL de conexión a PostgreSQL.
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Si DATABASE_URL tiene valor, la app usa Postgres (con pool de conexiones).
# Si se deja VACÍA o sin definir, la app cae a SQLite local (arrivata.db) —
# útil para desarrollar sin Postgres corriendo.
DATABASE_URL=

# Solo aplica al fallback SQLite: ruta del archivo .db.
# Vacío = arrivata.db en la carpeta del proyecto.
ARRIVATA_DB_PATH=

# 0 = apaga el modo debug de Flask (usar 0 en cualquier server).
FLASK_DEBUG=1

# ─── Google Sheets (opcional) ─────────────────────────────────────────
# Alternativa por variable de entorno a cargar esto desde la pestaña /sheets
# de la app. Útil en un host de filesystem efímero (Render free tier) donde
# lo guardado por la UI (config.json, credentials/) se pierde en cada
# reinicio — ver DEPLOY.md. En local, con el archivo ya subido a mano por
# /sheets, no hace falta ninguna de estas.
#
# JSON completo (una sola línea o multilínea) de la cuenta de servicio de
# Google — se escribe a credentials/google_credentials.json al arrancar.
GOOGLE_CREDENTIALS_JSON=
# URL de "Publicar en la web" en formato CSV — para "Importar desde Sheets".
SHEETS_CSV_URL=
# Clave y gid del spreadsheet — para "Probar conexión" / "Sincronizar todo".
SHEETS_SPREADSHEET_KEY=
SHEETS_GID=

# ─── Local ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
FLASK_SECRET_KEY=cambia-esto-por-algo-largo-y-secreto

# ─── Deploy (dejar vacío o sin definir en local) ─────────────────────
# Si APP_PASSWORD tiene valor, la app pide usuario + contraseña en todas las rutas.
APP_USER=arrivata
APP_PASSWORD=

# Ruta del archivo SQLite. Vacío = arrivata.db en la carpeta del proyecto.
ARRIVATA_DB_PATH=

# 0 = apaga el modo debug de Flask (usar 0 en cualquier server).
FLASK_DEBUG=1
